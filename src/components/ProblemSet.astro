---
/**
 * Problem-set browser, v2. Collapsed by default; opens into a designed
 * practice surface: numbered pills to jump between problems, one problem
 * per card with a tag-coloured spine, a button-driven solution reveal,
 * and progress marks on pills whose solutions have been seen.
 * Statements and solutions arrive as String.raw HTML (KaTeX-bearing)
 * from the module's MDX. Without JS the problems render stacked.
 */
interface Problem {
  tag: 'mechanical' | 'conceptual' | 'extension';
  statement: string;
  solution: string;
}
interface Props {
  problems: Problem[];
}
const { problems } = Astro.props;
---

{/* id must NOT be "problem-set" — the ## Problem Set heading's auto-slug already owns that id,
    and getElementById would return the heading instead of this element. */}
<details class="problem-set" id="ps-root">
  <summary>
    <span class="problem-set__eyebrow">Assessment</span>
    <span class="problem-set__title">Problem Set</span>
    <span class="problem-set__meta">{problems.length} problems · easy → hard · work on paper, then check</span>
  </summary>

  <div class="problem-set__body">

    {/* Cards 2+ ship hidden so the pre-JS render is already a single card,
        never a stacked list; without JS, the noscript style restores access. */}
    <noscript><style>{`.problem-card { display: block !important; } .problem-set__nav, .problem-set__pills { display: none !important; }`}</style></noscript>

    <div class="problem-set__pills" role="tablist" aria-label="Problems">
      {problems.map((p, i) => (
        <button class={i === 0 ? 'problem-set__pill is-active' : 'problem-set__pill'} data-goto={i} data-tag={p.tag} role="tab" aria-label={`Problem ${i + 1}, ${p.tag}`}>{i + 1}</button>
      ))}
    </div>

    <div class="problem-set__stage">
      {problems.map((p, i) => (
        <article class="problem-card" data-tag={p.tag} data-index={i} style={i === 0 ? undefined : 'display:none'}>
          <header class="problem-card__head">
            <span class="problem-card__num">Problem {i + 1}<span class="problem-card__of"> / {problems.length}</span></span>
            <span class="problem-tag" data-tag={p.tag}>{p.tag}</span>
          </header>
          <div class="problem-card__statement" set:html={p.statement} />
          <div class="problem-card__actions">
            <button class="problem-card__reveal">Reveal solution</button>
          </div>
          <div class="problem-card__solution" hidden>
            <p class="problem-card__solution-label">Solution</p>
            <div set:html={p.solution} />
          </div>
        </article>
      ))}
    </div>

    <div class="problem-set__nav">
      <button class="problem-set__nav-btn" id="ps-prev">← Previous</button>
      <span class="problem-set__legend">
        <span class="problem-set__legend-item" data-tag="mechanical">mechanical</span>
        <span class="problem-set__legend-item" data-tag="conceptual">conceptual</span>
        <span class="problem-set__legend-item" data-tag="extension">extension</span>
      </span>
      <button class="problem-set__nav-btn" id="ps-next">Next →</button>
    </div>

  </div>
</details>

<script is:inline>
(function() {
  var root = document.getElementById("ps-root");
  if (!root) return;
  var cards = Array.prototype.slice.call(root.querySelectorAll(".problem-card"));
  var pills = Array.prototype.slice.call(root.querySelectorAll(".problem-set__pill"));
  var prev = document.getElementById("ps-prev");
  var next = document.getElementById("ps-next");
  if (!cards.length || !prev || !next) return;
  var i = 0;

  function show(n) {
    i = Math.max(0, Math.min(cards.length - 1, n));
    cards.forEach(function(c, k) { c.style.display = k === i ? "" : "none"; });
    pills.forEach(function(p, k) {
      p.classList.toggle("is-active", k === i);
      p.setAttribute("aria-selected", String(k === i));
    });
    prev.disabled = i === 0;
    next.disabled = i === cards.length - 1;
  }

  cards.forEach(function(card, k) {
    var btn = card.querySelector(".problem-card__reveal");
    var sol = card.querySelector(".problem-card__solution");
    if (!btn || !sol) return;
    btn.addEventListener("click", function() {
      var open = sol.hasAttribute("hidden");
      if (open) { sol.removeAttribute("hidden"); btn.textContent = "Hide solution"; pills[k].classList.add("is-seen"); }
      else { sol.setAttribute("hidden", ""); btn.textContent = "Reveal solution"; }
    });
  });

  prev.addEventListener("click", function() { show(i - 1); });
  next.addEventListener("click", function() { show(i + 1); });
  pills.forEach(function(p) {
    p.addEventListener("click", function() { show(parseInt(p.getAttribute("data-goto"), 10)); });
  });

  show(0);
})();
</script>
