---
import Base from './Base.astro';

interface Section {
  id: string;
  label: string;
}

interface Props {
  day: number;
  title: string;
  description: string;
  sections: Section[];
}

const { day, title, description, sections } = Astro.props;

const NOTEBOOK_REPO = 'https://github.com/antndlcrx/Intro-to-LLMs-DPIR/blob/main/course_notebooks';
const COLAB_BASE = 'https://colab.research.google.com/github/antndlcrx/Intro-to-LLMs-DPIR/blob/main/course_notebooks';

const modules = [
  { day: 1, title: 'Foundations', slug: 'day-1', notebook: 'day_1_foundations/day1_embeddings_to_transformers.ipynb' },
  { day: 2, title: 'From Models to Tools', slug: 'day-2', notebook: 'day_2_models_to_tools/day2_from_models_to_tools.ipynb' },
  { day: 3, title: 'Deploying for Research', slug: 'day-3', notebook: 'day_3_deploying_for_research/day3_deploying_for_research.ipynb' },
  { day: 4, title: 'Extraction, Summarization, and RAG', slug: 'day-4', notebook: 'day_4_rag_survey_response_prediciton/day4_social_science_applications.ipynb' },
  { day: 5, title: 'Agentic Workflows', slug: 'day-5', notebook: 'day_5_agents/day5_agentic_workflows.ipynb' },
];

const currentIndex = modules.findIndex(m => m.day === day);
const current = modules[currentIndex];
const prev = currentIndex > 0 ? modules[currentIndex - 1] : null;
const next = currentIndex < modules.length - 1 ? modules[currentIndex + 1] : null;
const colabUrl = current ? `${COLAB_BASE}/${current.notebook}` : null;
const githubUrl = current ? `${NOTEBOOK_REPO}/${current.notebook}` : null;
---

<Base title={`Module ${day}: ${title}`} description={description}>

  <aside class="status-strip" aria-label="Page breadcrumb">
    <div class="status-strip-inner">
      <a href="/course/" style="color:inherit; text-decoration:none;">Course</a>
      <span class="sep"></span>
      <span>Module {day} of 5 — {title}</span>
    </div>
  </aside>

  <div class="course-page">

    <aside class="course-sidebar">
      <button class="course-sidebar__toggle" id="sidebar-toggle" aria-expanded="false">
        Course Modules ▾
      </button>
      <p class="course-sidebar__label">Modules</p>
      <ul class="course-sidebar__list" id="sidebar-list">
        {modules.map(m => (
          <li class="course-sidebar__module">
            <a
              href={`/course/${m.slug}/`}
              class:list={[
                'course-sidebar__module-link',
                { 'course-sidebar__module-link--active': m.day === day }
              ]}
            >
              <span class="course-sidebar__module-num">{m.day}.</span> {m.title}
            </a>
            {m.day === day && sections.length > 0 && (
              <ul class="course-sidebar__sections">
                {sections.map(s => (
                  <li>
                    <a href={`#${s.id}`} class="course-sidebar__section-link">{s.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </aside>

    <div class="course-content">

      <header class="course-header">
        <p class="course-header__day">Module {day} of 5</p>
        <h1 class="course-header__title">{title}</h1>
        <p class="course-header__desc">{description}</p>
        {colabUrl && (
          <p class="course-header__notebook" style="margin-top:18px; display:flex; gap:18px; align-items:center; flex-wrap:wrap;">
            <a class="btn-primary" href={colabUrl} target="_blank" rel="noopener">
              Open the Module {day} notebook in Colab <span class="arrow">→</span>
            </a>
            <a class="btn-link-v3" href={githubUrl} target="_blank" rel="noopener">
              View on GitHub <span class="arrow">→</span>
            </a>
          </p>
        )}
      </header>

      <div class="prose">
        <slot />
      </div>

      <nav class="course-nav" aria-label="Module navigation">
        {prev && (
          <a href={`/course/${prev.slug}/`} class="course-nav__link course-nav__link--prev">
            <span class="course-nav__dir">← Previous</span>
            <span class="course-nav__title">Module {prev.day}: {prev.title}</span>
          </a>
        )}
        {next && (
          <a href={`/course/${next.slug}/`} class="course-nav__link course-nav__link--next">
            <span class="course-nav__dir">Next →</span>
            <span class="course-nav__title">Module {next.day}: {next.title}</span>
          </a>
        )}
      </nav>

    </div>

  </div>
</Base>

<script>
  const toggle = document.getElementById('sidebar-toggle');
  const list = document.getElementById('sidebar-list');
  if (toggle && list) {
    toggle.addEventListener('click', () => {
      const open = list.classList.toggle('course-sidebar__list--open');
      toggle.setAttribute('aria-expanded', String(open));
    });
  }
</script>
