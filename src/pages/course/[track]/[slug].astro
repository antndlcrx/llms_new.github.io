---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { assertContentIntegrity } from '../../../lib/content-checks';

export async function getStaticPaths() {
  const modules = await getCollection('modules');
  assertContentIntegrity(modules);
  return modules.map((entry) => {
    const [track, ...rest] = entry.id.split('/');
    return { params: { track, slug: rest.join('/') }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

{/* Placeholder shell — replaced by the rewritten CourseLayout in increment 1.2/1.4. */}
<Base title={entry.data.title} description={entry.data.description}>
  <div class="course-page">
    <div class="course-content">
      <header class="course-header">
        <h1 class="course-header__title">{entry.data.title}</h1>
        <p class="course-header__desc">{entry.data.description}</p>
      </header>
      <div class="prose">
        <Content />
      </div>
    </div>
  </div>
</Base>
