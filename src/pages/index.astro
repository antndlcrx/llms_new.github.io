---
import Base from '../layouts/Base.astro';
import Partners from '../components/Partners.astro';
---

<Base title="Oxford LLMs">

  <!-- ═══════════════════════════════════════════════════════════
       HERO — aurora
       ═══════════════════════════════════════════════════════════ -->
  <div class="hero-aurora-wrap">
    <div class="hero-rule-top"></div>

    <div class="hero-dateline">
      <span>Nuffield College</span>
      <span class="sep"></span>
      <span>Est. 2023</span>
    </div>

    <!-- aurora blobs — colours driven by palette.css -->
    <div class="hero-aurora" aria-hidden="true">
      <div class="blob b1"></div>
      <div class="blob b2"></div>
      <div class="blob b3"></div>
    </div>

    <div class="shell hero-inner">
      <div class="eyebrow-v3" style="margin-bottom:24px">
        Oxford LLMs · Research · Teaching · Community
      </div>

      <h1 class="hero-title">
        <span class="word">Large</span>
        <span class="word">Language</span>
        <span class="word">Models</span>
        <span class="word">for</span>
        <span class="word accent">Social Science.</span>
      </h1>

      <p class="lede-v3 hero-lede-v3" style="margin-top:24px; max-width:600px;">
        We run an annual summer school at Nuffield College, develop an open-source
        course on the fundamentals of LLMs for social scientists, and work on
        methods research. Our faculty spans academic research and the ML industry.
      </p>

      <div class="hero-actions" style="margin-top:32px; display:flex; gap:12px; flex-wrap:wrap;">
        <a class="btn-primary" href="/summer-school/2026/">
          2026 highlights <span class="arrow">→</span>
        </a>
        <a class="btn-ghost" href="/research/">
          Research <span class="arrow">→</span>
        </a>
      </div>

      <div class="hero-meta">
        <span>Fourth edition · 13–17 July 2026</span>
        <span class="sep"></span>
        <span>Nuffield College, Oxford</span>
        <span class="sep"></span>
        <span>2027 dates to be announced</span>
      </div>
    </div>
  </div>

  <!-- Wide photograph between the type-led hero and the first section.
       Not a .reveal: that fires immediately for anything already in view, so
       the photo landed before the hero had finished animating in. It runs on
       the hero's own timeline instead, after the last hero line. -->
  <div class="shell home-band">
    <div class="photo-wide" style="margin:0;">
      <img src="/img/posts/report_2026/lecture_hall_2026.jpg"
           alt="A lecturer presenting to the cohort in the Nuffield College lecture room" />
    </div>
    <p class="photo-caption">Oxford LLMs 2026, Nuffield College</p>
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       § 01 RESEARCH
       ═══════════════════════════════════════════════════════════ -->
  <section class="section-v3 section-v3--marker">
    <span class="section-number">§ 01 · Research</span>

    <div class="shell">
      <div class="section-head-v3 reveal">
        <div>
          <div class="eyebrow-v3" style="margin-bottom:14px">Research</div>
          <h2 class="h-section">Methods for LLMs in social science.</h2>
        </div>
        <p class="lede-v3">
          We develop methods for applying language models to social science research.
          Code and datasets are open source on GitHub and Hugging Face.
        </p>
      </div>

      <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap: 20px;"
           class="reveal-stagger">

        <article class="fb">
          <span class="rule-soft"></span>
          <h3 class="h-sub" style="margin-bottom:10px">Synthetic data</h3>
          <p class="copy" style="margin:0; font-size:14px;">
            Can LLMs generate respondent panels that pass standard quality checks?
            When they do not, where do they fail, and can we measure it before we use them?
          </p>
        </article>

        <article class="fb">
          <span class="rule-soft"></span>
          <h3 class="h-sub" style="margin-bottom:10px">Opinion prediction</h3>
          <p class="copy" style="margin:0; font-size:14px;">
            How well do open-weights models recover real survey responses across languages,
            age cohorts, and political contexts, and what drives the gaps?
          </p>
        </article>

        <article class="fb">
          <span class="rule-soft"></span>
          <h3 class="h-sub" style="margin-bottom:10px">Evaluation</h3>
          <p class="copy" style="margin:0; font-size:14px;">
            Building eval sets that survive contamination, treating annotator disagreement
            as a measurement signal rather than noise.
          </p>
        </article>

      </div>

      <div class="reveal" style="margin-top:28px; display:flex; gap:14px; flex-wrap:wrap; align-items:center;">
        <a class="btn-ghost" href="/research/">
          Research <span class="arrow">→</span>
        </a>
        <a class="btn-link-v3" href="https://github.com/Oxford-LLMs-Research"
           target="_blank" rel="noopener">
          Oxford-LLMs-Research on GitHub <span class="arrow">→</span>
        </a>
        <a class="btn-link-v3" href="https://huggingface.co/oxford-llms"
           target="_blank" rel="noopener">
          Models on Hugging Face <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       § 02 SUMMER SCHOOL
       ═══════════════════════════════════════════════════════════ -->
  <section class="section-v3 section-v3--marker section-tinted-v3">
    <span class="section-number">§ 02 · Summer School</span>

    <div class="shell">
      <div class="section-head-v3 reveal">
        <div>
          <div class="eyebrow-v3" style="margin-bottom:14px">Annual intensive</div>
          <h2 class="h-section">Five days at Nuffield.</h2>
        </div>
        <p class="lede-v3">
          Early-career researchers. Lectures, labs, collaborative research.
          Four editions run since 2023.
        </p>
      </div>

      <!-- Cohort photo + materials. The 2026 teaser bar that used to sit here
           was a third link to /summer-school/2026/ within one screen; the
           cohort card below says the same thing with a photograph. -->
      <div class="ss-pair reveal-stagger">
        <article class="cohort-card">
          <img
            src="/img/posts/report_2026/group_photo_2026.jpg"
            alt="Oxford LLMs 2026 cohort group photo at Nuffield College"
          />
          <div class="cc-body">
            <span class="cc-tag">2026 Cohort</span>
            <h3 class="cc-title">Six teams. 5 days. Nuffield College.</h3>
            <p class="cc-desc">
              Lectures from practitioners on agents and evaluation, continual learning,
              compression, and inference economics, wrapped around a week-long prediction
              challenge.
            </p>
            <div class="cc-foot">
              <a class="btn-link-v3" href="/summer-school/2026/">
                See the highlights <span class="arrow">→</span>
              </a>
            </div>
          </div>
        </article>

        <article class="materials-card">
          <div class="m-tag">Past schools</div>
          <h3 class="m-title">Four years of cohorts.</h3>
          <ul class="m-list">
            <li>
              <a href="/summer-school/2026/">
                <span>Oxford LLMs 2026</span>
                <span class="m-meta">Highlights →</span>
              </a>
            </li>
            <li>
              <a href="/summer-school/2025/">
                <span>Oxford LLMs 2025</span>
                <span class="m-meta">Highlights →</span>
              </a>
            </li>
            <li>
              <a href="/summer-school/2024/">
                <span>Oxford LLMs 2024</span>
                <span class="m-meta">Highlights →</span>
              </a>
            </li>
            <li>
              <a href="/summer-school/2023/">
                <span>Oxford LLMs 2023</span>
                <span class="m-meta">Highlights →</span>
              </a>
            </li>
            <li>
              <a href="https://github.com/Oxford-LLMs-Research/oxford-llms-workshop"
                 target="_blank" rel="noopener">
                <span>Workshop materials</span>
                <span class="m-meta">GitHub →</span>
              </a>
            </li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       § 03 COURSE
       ═══════════════════════════════════════════════════════════ -->
  <section class="section-v3 section-v3--marker">
    <span class="section-number">§ 03 · Course</span>

    <div class="shell">
      <div class="section-head-v3 reveal">
        <div>
          <div class="eyebrow-v3" style="margin-bottom:14px">Open courseware</div>
          <h2 class="h-section">Language models for social science.</h2>
        </div>
        <p class="lede-v3">
          A five-module course mirroring the summer-school syllabus.
          Taught by invitation at Oxford, ESSCA Paris, and the EUI. All materials on GitHub.
        </p>
      </div>

      <div class="reveal">
        <div class="module-preview">
          <a class="mp-row" href="/course/day-1/">
            <span class="mp-num">Module 1</span>
            <span class="mp-title">Foundations</span>
            <span class="mp-meta">Embeddings · transformers</span>
          </a>
          <a class="mp-row" href="/course/day-2/">
            <span class="mp-num">Module 2</span>
            <span class="mp-title">From Models to Tools</span>
            <span class="mp-meta">Prompting · alignment</span>
          </a>
          <a class="mp-row" href="/course/day-3/">
            <span class="mp-num">Module 3</span>
            <span class="mp-title">Deploying for Research</span>
            <span class="mp-meta">Fine-tuning · inference</span>
          </a>
          <a class="mp-row" href="/course/day-4/">
            <span class="mp-num">Module 4</span>
            <span class="mp-title">Extraction &amp; RAG</span>
            <span class="mp-meta">Retrieval · grounding</span>
          </a>
          <a class="mp-row" href="/course/day-5/">
            <span class="mp-num">Module 5</span>
            <span class="mp-title">Agentic Workflows</span>
            <span class="mp-meta">Tool use · ReAct</span>
          </a>
        </div>

        <!-- Host institutions at full size. They stay clear of the sponsors
             by placement and by that band's own tinted section, not by being
             shrunk down. -->
        <div class="taught-at">
          <div class="taught-at-label">Also taught at</div>
          <div class="taught-at-row">
            <a class="inst-logo-card" href="https://www.politics.ox.ac.uk/" target="_blank" rel="noopener">
              <img src="/img/partners/dpir_spring_school.png" alt="DPIR Methods Spring School, University of Oxford" loading="lazy" />
              <p>Oxford · DPIR</p>
            </a>
            <a class="inst-logo-card" href="https://www.essca.fr/en/" target="_blank" rel="noopener">
              <img src="/img/partners/essca.png" alt="ESSCA Paris" loading="lazy" />
              <p>ESSCA · Paris</p>
            </a>
            <a class="inst-logo-card" href="https://www.eui.eu/" target="_blank" rel="noopener">
              <img src="/img/partners/eui.png" alt="European University Institute" loading="lazy" />
              <p>EUI · Florence</p>
            </a>
          </div>
        </div>

        <div class="course-actions">
          <a class="btn-ghost" href="/course/">Course details <span class="arrow">→</span></a>
          <a class="btn-link-v3" href="https://github.com/Oxford-LLMs-Research/Intro-to-LLMs-for-Social-Science"
             target="_blank" rel="noopener">Open on GitHub <span class="arrow">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       PARTNERS
       ═══════════════════════════════════════════════════════════ -->
  <section class="section-v3 section-tinted-v3 home-sponsors">
    <div class="shell">
      <Partners />
    </div>
  </section>


</Base>

<style>
  /* Module-preview rows are links, inherit colour, no underline */
  .mp-row {
    text-decoration: none;
    color: inherit;
  }

  /* Photo band sitting between the hero and § 01. Enters last in the hero
     sequence: title words run to ~0.64s, then lede 0.65s, actions 0.80s,
     meta 0.95s, so the photograph follows at 1.1s. */
  .home-band {
    margin: 0 auto clamp(24px, 4vw, 48px);
    opacity: 0; transform: translateY(14px);
    animation: hero-rise .8s cubic-bezier(.16,.84,.32,1) 1.1s forwards;
  }
  /* .photo-wide is 21:9, which crops this frame down to the lectern and
     loses the room. 16:9 keeps the screen, the speaker and the audience. */
  .home-band .photo-wide img { aspect-ratio: 16 / 9; }
  @media (prefers-reduced-motion: reduce) {
    .home-band { opacity: 1 !important; transform: none !important; animation: none !important; }
  }
  /* The hero now runs into a photograph rather than into open page. */
  .hero-aurora-wrap { padding-bottom: clamp(32px, 3.5vw, 48px); }

  /* Host institutions at full size, in the site's existing logo-card frame.
     What keeps them clear of the sponsors is distance and the sponsor band's
     own tinted section, not making these smaller. */
  .taught-at { margin-top: 30px; padding-top: 26px; border-top: 1px solid var(--border-lt); }
  .taught-at-label {
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-muted);
    margin-bottom: 16px;
  }
  .taught-at-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  a.inst-logo-card {
    display: block; text-decoration: none;
    transition: border-color .25s ease, transform .25s ease;
  }
  a.inst-logo-card:hover { border-color: var(--border-lt); transform: translateY(-2px); }
  .taught-at-row img {
    height: 40px; width: auto; max-width: 100%;
    object-fit: contain; object-position: left center; margin-bottom: 14px;
  }
  .taught-at-row p {
    margin: 0; font-family: var(--font-mono); font-size: 10.5px;
    text-transform: uppercase; letter-spacing: 0.12em; color: var(--text-muted);
  }
  .course-actions { margin-top: 26px; display: flex; gap: 12px; flex-wrap: wrap; }
  @media (max-width: 720px) { .taught-at-row { grid-template-columns: 1fr; } }

  /* Sponsors get their own tinted band with real breathing room, so they
     are plainly a separate thing from the course credits above. */
  .home-sponsors { padding: clamp(56px, 6.5vw, 88px) 0 clamp(48px, 5.5vw, 76px); }
</style>
